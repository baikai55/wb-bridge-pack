[Unit]
Description=WorkBuddy QQ Bridge (CodeBuddy CLI brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wb-bridge
EnvironmentFile=/opt/wb-bridge/bridge.env
ExecStart=/usr/bin/env node /opt/wb-bridge/bridge.mjs
Restart=always
RestartSec=15
# 小内存机器建议保留这两行，大机器可以删掉
MemoryMax=900M
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
