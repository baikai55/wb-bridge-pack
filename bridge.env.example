# 复制为 bridge.env，填好自己的值，chmod 600
# QQ 开放平台 → 机器人 → 开发设置
QQBOT_APPID=
QQBOT_APP_SECRET=

# 桥接程序所在目录（默认取 bridge.mjs 所在目录）
# WB_DIR=

# CodeBuddy CLI 可执行文件
# WB_CLI=/opt/node22/bin/codebuddy

# CLI 运行时的工作目录 / HOME（会话记录会落在 $HOME/.codebuddy/projects/<cwd名>/）
# WB_HOME=/root
# WB_CWD=/root
# WB_SESS_DIR=

# 主人 openid 文件，默认 <WB_DIR>/owner-openid.txt
# QQ_OPENID_FILE=

# Web 控制台端口（默认只监听 127.0.0.1）
# BOT_PANEL_PORT=8791
